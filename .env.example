# Clé secrète Django (Générer une nouvelle clé pour la production)
SECRET_KEY=your-django-secret-key

# Debug (Mettre False en production)
DEBUG=False

# Domaines autorisés séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Origines de confiance CSRF pour HTTPS sur Render
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.onrender.com

# Configuration PostgreSQL Supabase (Option A : Chaîne d'accès unique DATABASE_URL)
DATABASE_URL=postgresql://postgres.xxx:your-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Configuration PostgreSQL Supabase (Option B : Variables séparées)
DB_NAME=postgres
DB_USER=postgres.votre_project_ref
DB_PASSWORD=your-supabase-password
DB_HOST=aws-1-eu-west-3.pooler.supabase.com
DB_PORT=5432

# Configuration SMTP Gmail (Pour la réinitialisation de mot de passe)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application-gmail

# Clé API externe optionnelle pour les scripts d'importation
SPOONACULAR_API_KEY=your-spoonacular-api-key
